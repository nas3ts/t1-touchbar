#!/usr/bin/env python3
"""Turn the MacBook keyboard backlight off after idle and restore it on activity.

The applespi driver exposes the keyboard backlight as an LED class device
(/sys/class/leds/spi::kbd_backlight).  The driver has no idle timeout, so this
small service provides one: after N seconds without input it writes 0, and on
the next key/pointer event it restores the last non-zero brightness.

Runs as root under systemd.  Standard library only.
"""

import glob
import os
import select
import signal
import struct
import sys
import time

EVENT_STRUCT = struct.Struct("llHHi")
EVENT_SIZE = EVENT_STRUCT.size

EV_SYN = 0
EV_KEY = 1
EV_REL = 2
EV_ABS = 3
EV_SW = 5
SW_LID = 0

ACTIVITY_TYPES = {EV_KEY, EV_REL, EV_ABS}

LED_GLOB = "/sys/class/leds/*kbd*backlight*/brightness"
POLL_MS = 1000
RESCAN_SECS = 5.0
LED_RETRY_SECS = 5.0


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def find_led():
    paths = sorted(glob.glob(LED_GLOB))
    if not paths:
        return None
    # Prefer the applespi/spi backlight if several match.
    for path in paths:
        if "spi::kbd_backlight" in path:
            return path
    return paths[0]


def read_int(path):
    try:
        with open(path, "r", encoding="ascii") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def write_int(path, value):
    try:
        with open(path, "w", encoding="ascii") as f:
            f.write(str(int(value)))
        return True
    except OSError as exc:
        log(f"kbd-backlight: cannot write {path}: {exc}")
        return False


def is_activity(ev_type, ev_code, ev_value):
    if ev_type in ACTIVITY_TYPES:
        return True
    # Opening the lid is activity too.
    if ev_type == EV_SW and ev_code == SW_LID and ev_value == 0:
        return True
    return False


class BacklightTimeout:
    def __init__(self, timeout):
        self.timeout = timeout
        self.led = None
        self.saved = 0
        self.off = False
        self.last_activity = time.monotonic()
        self.last_led_try = 0.0
        self.last_led_warn = 0.0
        self.last_scan = 0.0
        self.events = {}          # path -> fd
        self.fd_to_path = {}      # fd -> path
        self.buffers = {}         # path -> bytes
        self.poller = select.poll()

    # ---- LED ---------------------------------------------------------
    def open_led(self):
        self.last_led_try = time.monotonic()
        path = find_led()
        if not path:
            now = time.monotonic()
            if now - self.last_led_warn >= 60:
                log("kbd-backlight: no *kbd*backlight* LED found; waiting")
                self.last_led_warn = now
            self.led = None
            return False

        self.led = path
        current = read_int(path)
        if current is None:
            log(f"kbd-backlight: cannot read {path}; waiting")
            self.led = None
            return False

        self.saved = current
        self.off = current == 0
        log(f"kbd-backlight: using {path} (brightness {current})")
        return True

    def ensure_led(self):
        if self.led is None and time.monotonic() - self.last_led_try >= LED_RETRY_SECS:
            self.open_led()

    # ---- input events -------------------------------------------------
    def open_event(self, path):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            return
        self.events[path] = fd
        self.fd_to_path[fd] = path
        self.buffers[path] = b""
        self.poller.register(fd, select.POLLIN)
        log(f"kbd-backlight: watching {path}")

    def close_event(self, path):
        fd = self.events.pop(path, None)
        if fd is None:
            return
        self.fd_to_path.pop(fd, None)
        self.buffers.pop(path, None)
        try:
            self.poller.unregister(fd)
        except OSError:
            pass
        try:
            os.close(fd)
        except OSError:
            pass

    def scan_events(self):
        now = time.monotonic()
        if now - self.last_scan < RESCAN_SECS:
            return
        self.last_scan = now

        present = set(glob.glob("/dev/input/event*"))
        for path in list(self.events):
            if path not in present:
                self.close_event(path)
        for path in present:
            if path not in self.events:
                self.open_event(path)

    def activity(self):
        self.last_activity = time.monotonic()
        if not self.off:
            return
        self.off = False
        if self.saved > 0 and self.led:
            if write_int(self.led, self.saved):
                log(f"kbd-backlight: restored to {self.saved}")

    def read_event(self, path):
        fd = self.events.get(path)
        if fd is None:
            return
        try:
            data = os.read(fd, EVENT_SIZE * 64)
        except BlockingIOError:
            return
        except OSError:
            self.close_event(path)
            return
        if not data:
            self.close_event(path)
            return

        buf = self.buffers.get(path, b"") + data
        count = len(buf) // EVENT_SIZE
        for i in range(count):
            _sec, _usec, ev_type, ev_code, ev_value = EVENT_STRUCT.unpack_from(
                buf, i * EVENT_SIZE
            )
            if is_activity(ev_type, ev_code, ev_value):
                self.activity()
        self.buffers[path] = buf[count * EVENT_SIZE:]

    # ---- timeout ------------------------------------------------------
    def check_timeout(self):
        self.ensure_led()
        if self.led is None:
            return

        current = read_int(self.led)
        if current is None:
            self.led = None
            return

        if self.off:
            # Someone else (PowerDevil, Fn keys, resume) turned it on; adopt
            # the new value and restart the idle timer.
            if current > 0:
                self.off = False
                self.saved = current
                self.last_activity = time.monotonic()
                log(f"kbd-backlight: external change, now {current}")
            return

        if self.timeout <= 0:
            return
        if time.monotonic() - self.last_activity < self.timeout:
            return

        if current == 0:
            # Already off for another reason; don't save 0 as the value to
            # restore.
            self.off = True
            self.saved = 0
            log("kbd-backlight: already off; waiting for activity")
            return

        self.saved = current
        if write_int(self.led, 0):
            self.off = True
            log(
                f"kbd-backlight: off after {self.timeout}s idle "
                f"(saved {self.saved})"
            )

    # ---- shutdown -----------------------------------------------------
    def shutdown(self):
        if self.off and self.saved > 0 and self.led:
            if write_int(self.led, self.saved):
                log(f"kbd-backlight: restored to {self.saved} on shutdown")
        self.off = False
        for path in list(self.events):
            self.close_event(path)

    def run(self):
        self.open_led()
        self.scan_events()
        while True:
            self.scan_events()
            for fd, revents in self.poller.poll(POLL_MS):
                path = self.fd_to_path.get(fd)
                if path is None:
                    continue
                if revents & (select.POLLERR | select.POLLHUP | select.POLLNVAL):
                    self.close_event(path)
                elif revents & select.POLLIN:
                    self.read_event(path)
            self.check_timeout()


def check_mode():
    path = find_led()
    if not path:
        print("no *kbd*backlight* LED found")
        return 1
    current = read_int(path)
    maximum = read_int(os.path.join(os.path.dirname(path), "max_brightness"))
    print(f"LED: {path}")
    print(f"  brightness={current} max={maximum}")
    print("input devices:")
    for event in sorted(glob.glob("/dev/input/event*")):
        name_path = f"/sys/class/input/{os.path.basename(event)}/device/name"
        try:
            with open(name_path, "r", encoding="utf-8") as f:
                name = f.read().strip()
        except OSError:
            name = "?"
        print(f"  {event}: {name}")
    return 0


def main():
    if "--check" in sys.argv[1:]:
        return check_mode()

    try:
        timeout = int(os.environ.get("KBD_BACKLIGHT_TIMEOUT", "30"))
    except ValueError:
        log("kbd-backlight: KBD_BACKLIGHT_TIMEOUT is not an integer")
        return 1
    if timeout < 0:
        log("kbd-backlight: KBD_BACKLIGHT_TIMEOUT must be >= 0")
        return 1

    if os.geteuid() != 0:
        log("kbd-backlight: must run as root (the systemd service does this)")
        return 1

    if timeout == 0:
        log("kbd-backlight: KBD_BACKLIGHT_TIMEOUT=0, timeout disabled")
        return 0

    daemon = BacklightTimeout(timeout)

    def on_signal(_signum, _frame):
        daemon.shutdown()
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    log(f"kbd-backlight: started, timeout {timeout}s")
    try:
        daemon.run()
    except SystemExit:
        raise
    except Exception as exc:  # keep the journal readable
        log(f"kbd-backlight: fatal: {exc!r}")
        daemon.shutdown()
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
